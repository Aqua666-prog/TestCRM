APP_ENV=development
DATABASE_URL=sqlite:///./crm.db
PUBLIC_BASE_URL=http://localhost:8000
CRM_USERNAME=admin
CRM_PASSWORD=change-me-local
APP_SECRET=change-me-local-secret
# Obtain from BotFather. Keep in secret storage, never in Git.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
